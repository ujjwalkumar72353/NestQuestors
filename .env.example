# Everything here is optional for local development.
# Without MONGO the app runs on a local MongoDB stored in .data/
MONGO=
JWT_SECRET=
# Set to true to add labelled demo rentals to a deployed site
SEED_DEMO=

# Without these, listing photos are stored in api/uploads
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Without this key the chat assistant uses built-in search only
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-astra
