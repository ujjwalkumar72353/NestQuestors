{
  "name": "nestquestors",
  "version": "1.0.0",
  "description": "",
  "type": "module",
  "main": "api/index.js",
  "scripts": {
    "dev": "concurrently -n api,web \"npm run server\" \"npm run client\"",
    "server": "nodemon --watch api --ignore api/test --ignore api/uploads api/index.js",
    "client": "npm run dev --prefix client",
    "setup": "npm install && npm install --prefix client",
    "build": "npm install --include=dev --prefix client && npm run build --prefix client",
    "start": "NODE_ENV=production node api/index.js",
    "test": "node --test --test-force-exit \"api/test/*.test.js\"",
    "test:e2e": "node e2e/run.js"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cloudinary": "^2.11.0",
    "cookie-parser": "^1.4.7",
    "dotenv": "^18.0.9",
    "express": "^4.22.3",
    "express-rate-limit": "^8.7.2",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^9.11.4",
    "multer": "^2.5.0",
    "zod": "^4.6.7"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "concurrently": "^10.0.6",
    "mongodb-memory-server": "^11.3.0",
    "nodemon": "^3.1.14",
    "playwright": "^1.64.1",
    "supertest": "^7.3.1"
  }
}
